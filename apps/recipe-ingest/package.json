{
  "name": "@hub/recipe-ingest",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host --port 5174",
    "build": "tsc --noEmit && vite build && node ./scripts/embed.mjs",
    "upload": "node ./scripts/upload.mjs",
    "deploy:page": "pnpm build && pnpm upload",
    "preview": "vite preview --host --port 5174",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@hub/shared": "workspace:*",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.9.3",
    "vite": "5.4.21"
  }
}
