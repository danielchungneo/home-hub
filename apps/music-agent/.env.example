# Copy to apps/music-agent/.env on the Pi (chmod 600). Never put these in the kiosk build.

# Supabase — use the service-role key so the agent can update commands/state and read integrations.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
HOUSEHOLD_ID=11111111-1111-1111-1111-111111111111

# Spotify developer app (Web API). Redirect URI must be exactly:
#   http://127.0.0.1:8888/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Filled by `pnpm --filter @hub/music-agent spotify:login`
SPOTIFY_REFRESH_TOKEN=

# Cookies from open.spotify.com (DevTools → Application → Cookies). Used only to wake Cast speakers.
# Copy both, then close the tab without logging out (logging out invalidates them).
SPOTIFY_SP_DC=
SPOTIFY_SP_KEY=

# Localhost search API for the kiosk (Caddy proxies /api/music → this port).
# MUSIC_AGENT_HTTP_PORT=8787
