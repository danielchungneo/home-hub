{
  "name": "smarthome-hub",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "dev:kiosk": "pnpm --filter @hub/kiosk dev",
    "build:kiosk": "pnpm --filter @hub/kiosk build",
    "deploy:pi": "powershell -ExecutionPolicy Bypass -File pi/deploy.ps1",
    "dev:music": "pnpm --filter @hub/music-agent dev",
    "dev:mobile": "pnpm --filter @hub/mobile start",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push --remote",
    "db:types": "supabase gen types typescript --remote > packages/shared/src/database.types.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "turbo": "^2.6.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4"
  }
}
