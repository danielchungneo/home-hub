# Set with: supabase secrets set OPENAI_API_KEY=sk-...
# Same key recipe-import already uses.
OPENAI_API_KEY=

# Workout coach model (must support Structured Outputs / json_schema).
# The repo already uses gpt-4o-mini in recipe-import — set the same here.
#   supabase secrets set COACH_MODEL=gpt-4o-mini
COACH_MODEL=

# Optional override; otherwise the coach reads households.timezone.
# HOUSEHOLD_TZ=America/New_York

# Kroger Public API (Locations + Products). Set with:
#   supabase secrets set KROGER_CLIENT_ID=... KROGER_CLIENT_SECRET=...
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
